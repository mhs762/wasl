{
  "expo": {
    "name": "wasl",
    "slug": "wasl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wasl",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A14"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "نستخدم موقعك لإظهار المستخدمين القريبين منك",
        "NSPhotoLibraryUsageDescription": "نستخدم مكتبة صورك لتحديث صورتك الشخصية"
      }
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.mhsnn.wasl"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "نستخدم صورك لتحديث الصورة الشخصية"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "نستخدم موقعك لإظهار المستخدمين القريبين"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "2869a189-0306-49f7-8af6-519f8cccacf2"
      }
    }
  }
}
